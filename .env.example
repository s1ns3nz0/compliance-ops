# Copy to .env and replace every placeholder. Do not commit .env.
# POSTGRES_PASSWORD_URLSAFE is embedded in DATABASE_URL. Use only URL-safe
# unreserved characters: A-Z, a-z, 0-9, hyphen, period, underscore, or tilde.
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD_URLSAFE=replace_with_url_safe_database_password
POSTGRES_DB=replace_with_database_name
MINIO_ROOT_USER=replace_with_minio_access_key
MINIO_ROOT_PASSWORD=replace_with_minio_secret_key

# Optional host-port overrides. Services bind to 127.0.0.1 only.
APP_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Optional application settings.
COMPLIANCE_BLOB_BUCKET=compliance-evidence
COMPLIANCE_AUDIT_ACTOR=operator
