# Frontend build output. Vite writes straight into internal/webui/dist (see
# web/vite.config.ts); internal/webui/.gitignore ignores that directory's
# contents while keeping the placeholder index.html / .gitkeep tracked so that
# `//go:embed all:dist` compiles from a fresh clone. Do NOT add a blanket
# `**/dist/` rule here: git cannot re-include files under an excluded directory.
web/dist/
